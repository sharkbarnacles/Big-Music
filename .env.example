# Copy this file to .env.local and fill in every value.
# NEVER share .env.local or upload it to GitHub — it holds your secrets.

# The address you open the app at. Keep 127.0.0.1 (not "localhost") while testing on your computer.
APP_URL=http://127.0.0.1:3000

# The password you'll type to get into your app.
APP_PASSWORD=choose-a-strong-password

# A long random string used to sign your login cookie. Any 40+ random characters.
SESSION_SECRET=paste-a-long-random-string-here

# Supabase → Project Settings → API (or "API Keys")
SUPABASE_URL=https://your-project-ref.supabase.co
# The SECRET key (starts with sb_secret_) or the legacy "service_role" key. Never the publishable/anon key.
SUPABASE_SECRET_KEY=

# Spotify Developer Dashboard → your app → Settings
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Google Cloud Console → APIs & Services → Credentials → your OAuth client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
